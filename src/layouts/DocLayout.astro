---
import Layout from '../components/Layout.vue';
import '../styles/global.css';
import { logo, navItems, sidebarItems, getPrevNext } from '../config';

const { title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const raw = Astro.url.pathname.replace(/\/+$/, '');
const currentLink = raw.replace(base, '') || '/';
const { prev, next } = getPrevNext(currentLink);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <Layout
      client:load
      logo={logo}
      navItems={navItems}
      sidebarItems={sidebarItems}
      currentPath={currentLink}
      prev={prev}
      next={next}
    >
      <slot />
    </Layout>
  </body>
</html>